eate a clock with 10ns period\\n    clock = Clock(dut.clk, 10, units=\"ns\")\\n    cocotb.start_soon(clock.start())\\n    \\n    # Reset the DFF\\n    dut.reset.value = 1\\n    dut.d.value = 1\\n    await RisingEdge(dut.clk)\\n    \\n    # Check if output is 0 after reset\\n    if dut.q.value != 0:\\n        raise TestFailure(f\"Reset failed! Q={dut.q.value} (expected 0)\")\\n    \\n    # Remove reset\\n    dut.reset.value = 0\\n    await RisingEdge(dut.clk)\\n    \\n    # Test both input values\\n    test_vectors = [0, 1, 0, 1]\\n    for val in test_vectors:\\n        dut.d.value = val\\n        await RisingEdge(dut.clk)\\n        if dut.q.value != val:\\n            raise TestFailure(f\"Test failed! D={val}, Q={dut.q.value}\")\\n\\n@cocotb.test()\\nasync def test_dff_reset(dut):\\n    \"\"\"Test reset functionality during operation\"\"\"\\n    \\n    clock = Clock(dut.clk, 10, units=\"ns\")\\n    cocotb.start_soon(clock.start())\\n    \\n    # Start with no reset\\n    dut.reset.value = 0\\n    dut.d.value = 1\\n    await RisingEdge(dut.clk)\\n    \\n    # Verify Q follows D\\n    if dut.q.value != 1:\\n        raise TestFailure(f\"Initial set failed! Q={dut.q.value} (expected 1)\")\\n    \\n    # Assert reset mid-operation\\n    dut.reset.value = 1\\n    await RisingEdge(dut.clk)\\n    \\n    # Check if output is 0 after reset\\n    if dut.q.value != 0:\\n        raise TestFailure(f\"Mid-operation reset failed! Q={dut.q.value} (expected 0)\")', new_content='import cocotb\\nfrom cocotb.clock import Clock\\nfrom cocotb.triggers import RisingEdge, Timer\\n\\n@cocotb.test()\\nasync def test_dff_basic(dut):\\n    \"\"\"Test basic D flip-flop functionality\"\"\"\\n    \\n    # Create a clock with 10ns period\\n    clock = Clock(dut.clk, 10, units=\"ns\")\\n    cocotb.start_soon(clock.start())\\n    \\n    # Initialize signals\\n    dut.reset.value = 0\\n    dut.d.value = 0\\n    \\n    # Wait a few clock cycles\\n    for _ in range(2):\\n        await RisingEdge(dut.cl